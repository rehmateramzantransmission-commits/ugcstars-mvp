# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ugcstars?schema=public"

# Auth
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Firebase (Phone OTP)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Payment Gateway (Safepay)
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_SANDBOX=true

# Storage (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="ugcstars-uploads"
S3_PUBLIC_URL=""

# Redis
REDIS_URL="redis://localhost:6379"

# Encryption (for PII like CNIC)
ENCRYPTION_KEY="your-32-byte-hex-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/trpc"
