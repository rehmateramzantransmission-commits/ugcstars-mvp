generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum Locale {
  EN
  UR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Slab {
  RISING
  EMERGING
  ESTABLISHED
  ELITE
  ICON
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
}

enum SocialVerificationMethod {
  OAUTH
  SCREENSHOT
  MANUAL
}

enum ContentRights {
  NONE
  REUSE_LIMITED
  REUSE_PERPETUAL
}

enum CampaignStatus {
  DRAFT
  FUNDED
  OPEN
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
  REFUNDED
}

enum SlotStatus {
  PLAN_SUBMITTED
  PLAN_REVISION_REQUESTED
  PLAN_APPROVED
  IN_PRODUCTION
  DRAFT_SUBMITTED
  DRAFT_REVISION_REQUESTED
  DRAFT_APPROVED
  PUBLISHED
  COMPLETED
  PAID
  CANCELLED
}

enum ContentPlanStatus {
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  DECLINED
}

enum DraftStatus {
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum EscrowTransactionType {
  FUND
  HOLD
  RELEASE
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerCategory {
  ESCROW_FUND
  ESCROW_RELEASE
  PLATFORM_FEE
  WHT
  PAYOUT
  REFUND
}

enum WithdrawalMethod {
  JAZZCASH
  EASYPAISA
  BANK_IBFT
  RAAST
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  PLAN_APPROVED
  REVISION_REQUESTED
  DRAFT_APPROVED
  PAYMENT_RELEASED
  NEW_CAMPAIGN
  DEADLINE_REMINDER
  VERIFICATION_COMPLETE
  KYC_STATUS
  WITHDRAWAL_STATUS
}

model User {
  id             String          @id @default(cuid())
  role           Role
  phone          String?         @unique
  phoneVerified  Boolean         @default(false)
  email          String?         @unique
  googleId       String?         @unique
  passwordHash   String?
  locale         Locale          @default(EN)
  status         UserStatus      @default(ACTIVE)
  avatarUrl      String?
  displayName    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]

  // Indexes for User
  @@index([phone])
  @@index([email])
  @@index([googleId])
  @@index([role])
}

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String?
  bio                String?
  avatarUrl          String?
  city               String?
  languages          String[]
  niches             String[]
  contentFormats     String[]
  slab               Slab?
  slabOverride       Slab?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id])
  socialAccounts     SocialAccount[]
  campaignSlots      CampaignSlot[]
  wallet             Wallet?
  kycRecord          KycRecord?
}

model BrandProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  companyName String
  logo        String?
  website     String?
  industry    String?
  bio         String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  campaigns   Campaign[]
}

model SocialAccount {
  id                 String                   @id @default(cuid())
  creatorProfileId   String
  platform           Platform
  handle             String
  profileUrl         String?
  followerCount      Int?
  verificationMethod SocialVerificationMethod
  screenshotUrl      String?
  verifiedAt         DateTime?
  status             VerificationStatus
  createdAt          DateTime                 @default(now())

  creatorProfile     CreatorProfile           @relation(fields: [creatorProfileId], references: [id])
}

model Campaign {
  id             String         @id @default(cuid())
  brandProfileId String
  title          String
  objective      String?
  category       String
  description    String
  briefAssets    Json           // array of {url, name, type}
  dosAndDonts    String?
  hashtags       String[]
  mentions       String[]
  targetSlabs    Slab[]
  deliverables   Json           // array of {type, count, description}
  contentRights  ContentRights
  rightsDuration Int?           // months
  deadline       DateTime
  budget         Decimal        @db.Decimal(12, 2)
  maxSlots       Int            @default(1)
  status         CampaignStatus
  fundedAt       DateTime?
  escrowRef      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brandProfile   BrandProfile   @relation(fields: [brandProfileId], references: [id])
  campaignSlots  CampaignSlot[]

  // Indexes for Campaign
  @@index([brandProfileId])
  @@index([status])
  @@index([category])
}

model CampaignSlot {
  id               String       @id @default(cuid())
  campaignId       String
  creatorProfileId String
  status           SlotStatus
  agreedBudget     Decimal?     @db.Decimal(12, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  contentPlans     ContentPlan[]
  drafts           Draft[]
  submission       Submission?
  escrowTransactions EscrowTransaction[]

  @@unique([campaignId, creatorProfileId])

  // Indexes for CampaignSlot
  @@index([campaignId])
  @@index([creatorProfileId])
  @@index([status])
}

model ContentPlan {
  id               String            @id @default(cuid())
  campaignSlotId   String
  version          Int               @default(1)
  concept          String?
  hook             String?
  outline          String?
  shotList         String?
  references       Json?
  proposedDates    Json?
  proposedPrice    Decimal?          @db.Decimal(12, 2)
  status           ContentPlanStatus
  brandComment     String?
  createdAt        DateTime          @default(now())

  campaignSlot     CampaignSlot      @relation(fields: [campaignSlotId], references: [id])
  comments         Comment[]
}

model Draft {
  id               String       @id @default(cuid())
  campaignSlotId   String
  version          Int          @default(1)
  fileUrl          String
  fileType         String?
  caption          String?
  status           DraftStatus
  brandComment     String?
  createdAt        DateTime     @default(now())

  campaignSlot     CampaignSlot @relation(fields: [campaignSlotId], references: [id])
  comments         Comment[]
}

model Submission {
  id               String       @id @default(cuid())
  campaignSlotId   String       @unique
  postUrl          String
  screenshots      Json
  metrics          Json?
  submittedAt      DateTime     @default(now())
  approvedAt       DateTime?

  campaignSlot     CampaignSlot @relation(fields: [campaignSlotId], references: [id])
}

model Comment {
  id               String       @id @default(cuid())
  userId           String
  contentPlanId    String?
  draftId          String?
  parentId         String?
  body             String
  createdAt        DateTime     @default(now())

  contentPlan      ContentPlan? @relation(fields: [contentPlanId], references: [id])
  draft            Draft?       @relation(fields: [draftId], references: [id])
  parent           Comment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies          Comment[]    @relation("CommentThread")
}

model Wallet {
  id               String       @id @default(cuid())
  creatorProfileId String       @unique
  availableBalance Decimal      @default(0) @db.Decimal(12, 2)
  inEscrowBalance  Decimal      @default(0) @db.Decimal(12, 2)
  lifetimeEarnings Decimal      @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime     @updatedAt

  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  ledgerEntries    LedgerEntry[]
  withdrawals      Withdrawal[]
}

model EscrowTransaction {
  id               String                @id @default(cuid())
  campaignSlotId   String
  type             EscrowTransactionType
  amount           Decimal               @db.Decimal(12, 2)
  platformFee      Decimal?              @db.Decimal(12, 2)
  whtAmount        Decimal?              @db.Decimal(12, 2)
  netAmount        Decimal?              @db.Decimal(12, 2)
  gatewayRef       String?
  idempotencyKey   String                @unique
  status           TransactionStatus
  createdAt        DateTime              @default(now())
  processedAt      DateTime?

  campaignSlot     CampaignSlot          @relation(fields: [campaignSlotId], references: [id])
  ledgerEntries    LedgerEntry[]

  // Indexes for EscrowTransaction
  @@index([campaignSlotId])
  @@index([status])
}

model LedgerEntry {
  id                  String             @id @default(cuid())
  walletId            String?
  escrowTransactionId String?
  type                LedgerEntryType
  category            LedgerCategory
  amount              Decimal            @db.Decimal(12, 2)
  balanceAfter        Decimal            @db.Decimal(12, 2)
  description         String?
  createdAt           DateTime           @default(now())

  wallet              Wallet?            @relation(fields: [walletId], references: [id])
  escrowTransaction   EscrowTransaction? @relation(fields: [escrowTransactionId], references: [id])

  // Indexes for LedgerEntry
  @@index([walletId])
  @@index([createdAt])
}

model Withdrawal {
  id               String           @id @default(cuid())
  walletId         String
  amount           Decimal          @db.Decimal(12, 2)
  method           WithdrawalMethod
  accountDetails   String           // encrypted
  accountTitle     String?
  status           WithdrawalStatus
  processedAt      DateTime?
  gatewayRef       String?
  adminNote        String?
  createdAt        DateTime         @default(now())

  wallet           Wallet           @relation(fields: [walletId], references: [id])
}

model KycRecord {
  id               String         @id @default(cuid())
  creatorProfileId String         @unique
  fullName         String
  cnicNumber       String         // encrypted
  cnicFrontUrl     String
  cnicBackUrl      String
  selfieUrl        String
  isFiler          Boolean?
  fbrVerifiedAt    DateTime?
  status           KycStatus
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime       @default(now())

  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  // Indexes for Notification
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON encoded
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  // Indexes for AuditLog
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
